{
  "name": "messa",
  "private": true,
  "version": "0.1.0",
  "description": "Messa — Garçom Virtual. SaaS multi-tenant para bares e restaurantes.",
  "packageManager": "pnpm@9.1.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:local": "pnpm --filter @messa/db local",
    "db:generate": "pnpm --filter @messa/db generate",
    "db:migrate": "pnpm --filter @messa/db migrate",
    "db:seed": "pnpm --filter @messa/db seed",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
