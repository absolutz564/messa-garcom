# --- Banco ---
# Role da aplicação (sem BYPASSRLS). Criada pela migration 0001_rls.sql.
DATABASE_URL=postgres://messa_app:messa_app@localhost:5432/messa
# Role de migrations (owner das tabelas).
DATABASE_MIGRATOR_URL=postgres://messa:messa@localhost:5432/messa

# --- API ---
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
WEB_PUBLIC_URL=http://localhost:3000
# URL base impressa nos QR Codes. Em produção: https://messa-garcom.com.br
QR_BASE_URL=http://localhost:3000

# Segredos (gerar com: openssl rand -base64 48)
JWT_SECRET=change-me-jwt-secret-with-at-least-32-chars
COOKIE_SECRET=change-me-cookie-secret-with-at-least-32-chars
# Chave de 32 bytes em base64 para cifrar o PIN (PDR-005). Valor abaixo serve só para dev; em produção: openssl rand -base64 32
PIN_ENCRYPTION_KEY=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Opcional ---
SENTRY_DSN=
LOG_LEVEL=info

# --- E-mail (convites). Sem chave, o link do convite é exibido na tela.
RESEND_API_KEY=
EMAIL_FROM=Messa <no-reply@messa-garcom.com.br>
# Diretório de uploads (produção: volume persistente)
UPLOADS_DIR=

# --- Cobrança (BR-20/ADR-006). Sem token, a cobrança automática fica indisponível — nada quebra.
MERCADO_PAGO_ACCESS_TOKEN=
